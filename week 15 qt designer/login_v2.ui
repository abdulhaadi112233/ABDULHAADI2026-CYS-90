  <property name="styleSheet">
   <string notr="true">/* ---- Outer dialog: deep blue gradient backdrop ---- */
QDialog {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #0b2545, stop:1 #134074
    );
}

/* ---- Floating white card ---- */
QFrame#card {
    background-color: #ffffff;
    border-radius: 18px;
}

/* ---- Logo circle ---- */
QLabel#logoCircle {
    background-color: #134074;
    color: white;
    font-size: 22px;
    font-weight: bold;
    border-radius: 36px;
}

/* ---- Text ---- */
QLabel#titleLabel {
    color: #0b2545;
    font-size: 17px;
    font-weight: 600;
}
QLabel#subtitleLabel {
    color: #6b7a90;
    font-size: 12px;
}
QLabel#sectionLabel {
    color: #1b2a41;
    font-size: 18px;
    font-weight: bold;
}
QLabel#fieldCaption {
    color: #45526b;
    font-size: 11px;
    font-weight: 600;
}
QLabel#footerLabel {
    color: #9aa6b8;
    font-size: 10px;
}
QLabel#errorLabel {
    color: #d64545;
    font-size: 11px;
}
QLabel#linkLabel {
    color: #134074;
    font-size: 11px;
    font-weight: 600;
}

/* ---- Inputs ---- */
QLineEdit {
    background-color: #f4f6f9;
    border: 1.5px solid #e2e6ed;
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 13px;
    color: #1b2a41;
    selection-background-color: #134074;
}
QLineEdit:focus {
    border: 1.5px solid #134074;
    background-color: #ffffff;
}

/* ---- Show/hide password toggle ---- */
QToolButton#togglePasswordButton {
    border: none;
    background: transparent;
    color: #6b7a90;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 8px;
}
QToolButton#togglePasswordButton:hover {
    color: #134074;
}

/* ---- Remember me checkbox ---- */
QCheckBox#rememberCheckBox {
    color: #45526b;
    font-size: 11px;
    spacing: 6px;
}
QCheckBox#rememberCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 4px;
    border: 1.5px solid #c4cbd8;
}
QCheckBox#rememberCheckBox::indicator:checked {
    background-color: #134074;
    border: 1.5px solid #134074;
}

/* ---- Login button ---- */
QPushButton#loginButton {
    background-color: #134074;
    color: white;
    font-weight: bold;
    font-size: 14px;
    border-radius: 10px;
    padding: 13px;
}
QPushButton#loginButton:hover {
    background-color: #0d2f57;
}
QPushButton#loginButton:pressed {
    background-color: #081f3d;
}</string>
